{
  "name": "@accounterbro/api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-e2e/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["@accounterbro/api"],
  "targets": {
    "api-server": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run @accounterbro/api:migration:run && pnpm nx run @accounterbro/api:serve:e2e"
      }
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/api-e2e/jest.config.cts",
        "passWithNoTests": true,
        "runInBand": true
      },
      "dependsOn": [
        {
          "projects": ["@accounterbro/api-e2e"],
          "target": "api-server"
        }
      ]
    }
  }
}
