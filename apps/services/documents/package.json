{
    "name": "@accounterbro/documents-service",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "typeorm": "ts-node -P ./tsconfig.app.json ./node_modules/typeorm/cli.js",
        "migration:generate": "ts-node -P ./tsconfig.app.json ./node_modules/typeorm/cli.js migration:generate -d ./src/app/infrastructure/persistence/typeorm/data-source.ts",
        "migration:run": "ts-node -P ./tsconfig.app.json ./node_modules/typeorm/cli.js migration:run -d ./src/app/infrastructure/persistence/typeorm/data-source.ts",
        "migration:revert": "ts-node -P ./tsconfig.app.json ./node_modules/typeorm/cli.js migration:revert -d ./src/app/infrastructure/persistence/typeorm/data-source.ts",
        "migration:show": "ts-node -P ./tsconfig.app.json ./node_modules/typeorm/cli.js migration:show -d ./src/app/infrastructure/persistence/typeorm/data-source.ts"
    },
    "dependencies": {
        "@accounterbro/core": "workspace:*",
        "@accounterbro/documents": "workspace:*",
        "@accounterbro/object-storage": "workspace:*",
        "@accounterbro/runtime-config": "workspace:*",
        "@accounterbro/service-runtime": "workspace:*",
        "@event-driven-platform/actor": "^0.1.3",
        "@event-driven-platform/clock": "^0.0.5",
        "@event-driven-platform/execution": "^0.0.4",
        "@event-driven-platform/intent": "^0.2.0",
        "@event-driven-platform/runner": "^0.0.6",
        "@event-driven-platform/use-case": "^0.0.3",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.0",
        "@nestjs/typeorm": "^11.0.3",
        "pg": "catalog:",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "tslib": "catalog:",
        "typeorm": "catalog:",
        "zod": "catalog:"
    }
}
