        {
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "unit": "short"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 8
            },
            "id": 5,
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${DS_PROMETHEUS}"
                    },
                    "editorMode": "code",
                    "expr": "sum by (edp_component, edp_name) ({__name__=~\"edp_retry_scheduled.*_total\"})",
                    "legendFormat": "{{edp_component}} / {{edp_name}}",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Documents EDP retries scheduled",
