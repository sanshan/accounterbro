{
    "name": "@accounterbro/runtime-messaging",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./nest": {
            "types": "./dist/nest.d.ts",
            "import": "./dist/nest.js",
            "default": "./dist/nest.js"
        },
        "./redpanda": {
            "types": "./dist/redpanda.d.ts",
            "import": "./dist/redpanda.js",
            "default": "./dist/redpanda.js"
        }
    },
    "dependencies": {
        "@event-driven-platform/event": "^0.2.0",
        "@event-driven-platform/event-schema-avro": "0.0.3",
        "@kafkajs/confluent-schema-registry": "4.1.0",
        "@nestjs/common": "^11.0.0",
        "kafkajs": "2.2.4",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@event-driven-platform/execution": "^0.0.8",
        "@nestjs/core": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "reflect-metadata": "^0.2.2"
    }
}
